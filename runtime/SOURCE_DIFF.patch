+std::string SnapshotSafeToken(const std::string& value)
+{
+    std::string result=value.empty()?"UNSPECIFIED":value;
+    for(std::size_t i=0;i<result.size();++i)
+        if(!std::isalnum(static_cast<unsigned char>(result[i]))
+           && result[i]!='-' && result[i]!='_')
+            result[i]='_';
+    return result;
+}
